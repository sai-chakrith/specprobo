SPECPROBE_DATABASE_URL=sqlite:///specprobe.db
SPECPROBE_VECTOR_PATH=.specprobe/chroma
SPECPROBE_API_URL=http://127.0.0.1:8000
SPECPROBE_AUTH_MODE=individual
# Set a private secret file; never commit credentials or provide them in URL parameters.
# SPECPROBE_ADMIN_SECRET_FILE=C:/private/specprobe-admin.secret
# SPECPROBE_ADMIN_SECRET_PATH=C:/private/specprobe-admin.secret
# SPECPROBE_AUTH_MODE=workspace_key is an explicit localhost demo compatibility mode.
# Optional local inference. Environment variables must be exported; .env is not auto-loaded.
# SPECPROBE_OLLAMA_URL=http://127.0.0.1:11434
# SPECPROBE_OLLAMA_MODEL=llama3.2
# SPECPROBE_EXTRACTION_MODE=ollama
# SPECPROBE_EMBED_MODEL_PATH=C:/models/bge-small-en-v1.5
